/*
 * File        getstart.ul
 * About       A simple example written in U language.
 * Author      ZirconiumTian
 */

using "sysio.umod";
using "string.umod";
using "error.umod";

fn ask_for_age(age: &int32): bool
{
	input: string = getln();
	catch none in age = string_to_int(@input) {
		return false;
	}
	return true;
}

fn main(): int32
{
	putln("Hey, glad you're here! Welcome to U.");
	puts("What should I call you? ");
	name: string;
	while true {
		name = getln();
		name = trim(@name);
		if not name.empty() {
			break;
		}
		puts("I didn't catch that. What should I call you? ");
	}

	puts(f"Nice to meet you, {name}! One more question: how old are you? ");
	age: int32;
	while true {
		if not ask_for_age(&age) {
			puts("I couldn't read that as a whole number. Give it another try? ");
			continue;
		}
		if age >= 0 {
			break;
		}
		puts("That came out negative. Mind trying again? ");
	}

	if age < 18 {
		putln("You're under 18. I hope you find something fun to build with U!");
	} else if age > 18 {
		putln("You're an adult. I hope U gives you a fun excuse to try something new.");
	} else {
		putln("Eighteen! I hope it's a good year for you.");
	}

	putln(f"Thanks for spending a little time with U, {name}. See you around!");
	return 0;
}
